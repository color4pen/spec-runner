ot unconditional)."},{"severity":"low","file":"src/adapter/managed-agent/__tests__/prompt-rules-injection.test.ts","title":"F2 (MEDIUM prior round) — resolved: TC-017 and TC-018 adapter tests implemented","rationale":"TC-017 (managed polling path) and TC-018 (codex adapter) position-pinning tests are present. TC-017 verifies resumeIdx < rulesIdx < gitPushIdx in the polling-path initialMessage. TC-018 verifies resumeIdx < rulesIdx < completionIdx in the codex prompt."},{"severity":"low","file":"src/core/step/rules-delivery.ts","title":"F3 (LOW prior round) — resolved: cross-reference comments added per operator adjudication","rationale":"rules-delivery.ts line 17–18 and reviewers/definition.ts line 68–69 each carry the cross-reference comment: 'NOTE: the same frontmatter convention is also implemented in <other-file>. If the --- delimiter convention changes, update both files.'"}]},"followUpAttempts":0,"transientRetryAttempts":0,"addedTurns":{"reportRetry":0,"postWork":0,"outputRepair":0}},"startedAt":"2026-08-16T16:30:12.076Z","endedAt":"2026-08-16T16:37:42.231Z"}
